# Copier ce fichier vers .env et renseigner les valeurs.
# Le .env n'est jamais versionné.

# Développement local : mettre à 1. En production : laisser vide ou 0.
PSC_DEBUG=1

# Clé de signature Django. Obligatoire hors DEBUG.
# Générer avec : python psc/manage.py generate_secret_key
PSC_SECRET_KEY=

# Noms d'hôtes autorisés, séparés par des virgules.
PSC_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines de confiance pour le CSRF, en production derrière un nom de domaine.
# PSC_CSRF_TRUSTED_ORIGINS=https://calendrier.example.org

# Mot de passe unique d'accès au site, sous forme hachée.
# Générer avec : python psc/manage.py hash_access_password
PSC_ACCESS_PASSWORD_HASH=

# Nombre de tentatives avant blocage temporaire, et durée du blocage.
PSC_ACCESS_MAX_ATTEMPTS=10
PSC_ACCESS_LOCKOUT_SECONDS=900

# Emplacement de la base SQLite. Par défaut : <dépôt>/data/psc.sqlite3
# PSC_DB_PATH=

# Production
# PSC_SECURE_SSL_REDIRECT=1
# PSC_BEHIND_PROXY=1
